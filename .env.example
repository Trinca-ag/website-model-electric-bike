# ---------------------------------------------------------------------------
# Variáveis de ambiente
# Copie este arquivo para `.env.local` e ajuste os valores.
# `.env.local` NÃO é versionado (veja .gitignore).
# ---------------------------------------------------------------------------

# URL pública e canônica do site, SEM barra no final.
#
# Onde é usada:
#   - src/data/site.ts  -> SITE.url
#   - metadataBase (canonical de todas as páginas)   — src/app/layout.tsx
#   - Open Graph / Twitter Card                       — src/app/layout.tsx
#   - sitemap.xml                                     — src/app/sitemap.ts
#   - robots.txt (linha Sitemap:)                     — src/app/robots.ts
#
# Precisa do prefixo NEXT_PUBLIC_ porque também é lida durante o build estático.
# Se não for definida, o fallback é https://exemplo.com.br (src/data/site.ts).
#
# Na Vercel, cadastre em Settings > Environment Variables:
#   Production : https://exemplo.com.br
#   Preview    : a URL do deploy de preview (ou deixe em branco para usar o fallback)
NEXT_PUBLIC_SITE_URL=https://exemplo.com.br
